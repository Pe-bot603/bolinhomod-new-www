{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "rewrites": [
    {"source": "/", "destination": "/splash.html"},
    {"source": "/projects/:path*", "destination": "/projects.html"},
    {"source": "/messages/:path*", "destination": "/messages.html"},
    {"source": "/studios/:path*", "destination": "/studio.html"},
    {"source": "/explore/:path*", "destination": "/explore.html"},
    {"source": "/search/:path*", "destination": "/search.html"},
    {"source": "/download/link", "destination": "/download.html"},
    {"source": "/:path((?!.*\\.).*)", "destination": "/:path.html"}
  ]
}
